# Copy to .env and replace these values before running.
POSTGRES_PASSWORD=dev-only-change-me
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Optional: when set, the server sends only rule IDs and numeric detection facts to Groq.
# Keep this key private; without it, explanations use deterministic rule text.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
